{
  "name": "Stagepay guide handover",
  "url": "http://127.0.0.1:4321",
  "width": 1440,
  "height": 900,
  "planned_only": true,
  "target_seconds": 180,
  "target_basis": "Working target; the checked event rules specify no numeric limit.",
  "steps": [
    {
      "action": "wait",
      "hold_ms": 4000,
      "caption": "Keep the work and its payment decision together."
    },
    {
      "action": "click",
      "selector": ".toolbar button[data-ui=\"create\"]",
      "hold_ms": 3000,
      "caption": "Start with a clear agreement."
    },
    {
      "action": "fill",
      "selector": "input[name=\"title\"]",
      "hold_ms": 2200,
      "caption": "Name the demo job.",
      "value": "Stagepay guide handover"
    },
    {
      "action": "fill",
      "selector": "textarea[name=\"scope\"]",
      "hold_ms": 4000,
      "caption": "Write what counts as complete.",
      "value": "Demo job: deliver a local setup guide, a contract behavior guide, and a handover checklist. Each delivery must link to a real public Markdown file in this repository. These test tokens have no cash value."
    },
    {
      "action": "fill",
      "selector": "input[name=\"name0\"]",
      "hold_ms": 2000,
      "caption": "Name step 1.",
      "value": "Setup guide"
    },
    {
      "action": "fill",
      "selector": "input[name=\"amount0\"]",
      "hold_ms": 2200,
      "caption": "Set payment 1.",
      "value": "10"
    },
    {
      "action": "fill",
      "selector": "input[name=\"name1\"]",
      "hold_ms": 2000,
      "caption": "Name step 2.",
      "value": "Behavior guide"
    },
    {
      "action": "fill",
      "selector": "input[name=\"amount1\"]",
      "hold_ms": 2200,
      "caption": "Set payment 2.",
      "value": "20"
    },
    {
      "action": "fill",
      "selector": "input[name=\"name2\"]",
      "hold_ms": 2000,
      "caption": "Name step 3.",
      "value": "Handover checklist"
    },
    {
      "action": "fill",
      "selector": "input[name=\"amount2\"]",
      "hold_ms": 2200,
      "caption": "Set payment 3.",
      "value": "5"
    },
    {
      "action": "click",
      "selector": "input[name=\"acknowledge\"]",
      "hold_ms": 4500,
      "caption": "Test tokens only. A dispute needs both people to agree."
    },
    {
      "action": "click",
      "selector": "form[data-form=\"create\"] button.primary",
      "hold_ms": 4500,
      "caption": "Fund the agreement and wait for its receipt.",
      "expect": ".heading .status.awaiting_agreement"
    },
    {
      "action": "select",
      "selector": "#actor",
      "hold_ms": 2200,
      "caption": "Switch to Freelancer.",
      "value": "freelancer"
    },
    {
      "action": "click",
      "selector": "button[data-action=\"join\"]",
      "hold_ms": 4000,
      "caption": "Agree to the recorded scope.",
      "expect": ".heading .status.in_progress"
    },
    {
      "action": "fill",
      "selector": "form[data-form=\"submit\"][data-index=\"0\"] input[name=\"url\"]",
      "hold_ms": 2200,
      "caption": "Link the first setup note.",
      "value": "https://github.com/gylshaurya/stagepay/blob/main/demo/evidence/setup-note-initial.md"
    },
    {
      "action": "fill",
      "selector": "form[data-form=\"submit\"][data-index=\"0\"] textarea[name=\"note\"]",
      "hold_ms": 2600,
      "caption": "Say what the note includes.",
      "value": "Initial demo delivery: basic startup commands. Recovery steps still need to be added."
    },
    {
      "action": "click",
      "selector": "form[data-form=\"submit\"][data-index=\"0\"] button",
      "hold_ms": 3500,
      "caption": "Submit the first delivery.",
      "expect": "#milestones .milestone:first-of-type .status.submitted"
    },
    {
      "action": "select",
      "selector": "#actor",
      "hold_ms": 2200,
      "caption": "Review as Client.",
      "value": "client"
    },
    {
      "action": "click",
      "selector": "#milestones summary:has-text(\"Request a revision\")",
      "hold_ms": 2200,
      "caption": "Ask for a revision."
    },
    {
      "action": "fill",
      "selector": "form[data-form=\"revision\"] textarea[name=\"note\"]",
      "hold_ms": 2500,
      "caption": "Name the missing section.",
      "value": "Please include what to do when a transaction is interrupted."
    },
    {
      "action": "click",
      "selector": "form[data-form=\"revision\"] button",
      "hold_ms": 4500,
      "caption": "The revision keeps all 35 DEMO in escrow.",
      "expect": "#milestones .milestone:first-of-type .status.pending"
    },
    {
      "action": "select",
      "selector": "#actor",
      "hold_ms": 2200,
      "caption": "Return to Freelancer.",
      "value": "freelancer"
    },
    {
      "action": "fill",
      "selector": "form[data-form=\"submit\"][data-index=\"0\"] input[name=\"url\"]",
      "hold_ms": 2200,
      "caption": "Link the complete guide.",
      "value": "https://github.com/gylshaurya/stagepay/blob/main/docs/SETUP.md"
    },
    {
      "action": "fill",
      "selector": "form[data-form=\"submit\"][data-index=\"0\"] textarea[name=\"note\"]",
      "hold_ms": 2500,
      "caption": "Explain what changed.",
      "value": "Revised demo delivery: the full guide includes interrupted transactions, preserved records and recovery limits."
    },
    {
      "action": "click",
      "selector": "form[data-form=\"submit\"][data-index=\"0\"] button",
      "hold_ms": 3500,
      "caption": "Submit the revised work.",
      "expect": "#milestones .milestone:first-of-type .status.submitted"
    },
    {
      "action": "select",
      "selector": "#actor",
      "hold_ms": 2200,
      "caption": "Review the new evidence.",
      "value": "client"
    },
    {
      "action": "click",
      "selector": "button[data-action=\"accept\"][data-index=\"0\"]",
      "hold_ms": 4500,
      "caption": "Accept once: 10 DEMO becomes wallet credit.",
      "expect": "#milestones .milestone:first-of-type .status.accepted"
    },
    {
      "action": "click",
      "selector": "summary:has-text(\"Agreement options\")",
      "hold_ms": 2000,
      "caption": "Open agreement options."
    },
    {
      "action": "click",
      "selector": "summary:has-text(\"Change the unpaid scope\")",
      "hold_ms": 2200,
      "caption": "Change the unpaid scope."
    },
    {
      "action": "fill",
      "selector": "form[data-form=\"scope\"] textarea[name=\"scope\"]",
      "hold_ms": 3500,
      "caption": "Keep accepted work. Clarify the remaining work.",
      "value": "Demo job: keep the accepted setup guide. The behavior guide must explain paused transactions and the limits of recovery. Deliver a handover checklist too. Remaining deliveries must link to real public Markdown files. Test tokens have no cash value."
    },
    {
      "action": "click",
      "selector": "form[data-form=\"scope\"] button",
      "hold_ms": 3500,
      "caption": "Propose the change.",
      "expect": ".proposal"
    },
    {
      "action": "select",
      "selector": "#actor",
      "hold_ms": 2200,
      "caption": "Review as Freelancer.",
      "value": "freelancer"
    },
    {
      "action": "click",
      "selector": "button[data-action=\"agree_scope\"]",
      "hold_ms": 4500,
      "caption": "Agree. Accepted work stays paid.",
      "expect": "#milestones .milestone:nth-of-type(2) .status.pending"
    },
    {
      "action": "scroll",
      "selector": ".receipts",
      "hold_ms": 4000,
      "caption": "The scope change has its own receipt."
    },
    {
      "action": "click",
      "selector": "details.receipt:has-text(\"Both parties agreed to the new scope\") > summary",
      "hold_ms": 4500,
      "caption": "Check the real local transaction and scope hash."
    },
    {
      "action": "click",
      "selector": "button[data-action=\"withdraw\"]",
      "hold_ms": 4500,
      "caption": "Withdraw wallet credit. Leave 25 DEMO in escrow.",
      "expect": "details.receipt:has-text(\"Freelancer withdrew\")"
    },
    {
      "action": "scroll",
      "selector": ".receipts",
      "hold_ms": 3500,
      "caption": "Keep the withdrawal receipt with the work."
    },
    {
      "action": "click",
      "selector": "button[data-ui=\"export\"]",
      "hold_ms": 3500,
      "caption": "Export the project record."
    },
    {
      "action": "click",
      "selector": "summary:has-text(\"Network and demo wallets\")",
      "hold_ms": 4000,
      "caption": "Local contracts are real. Sepolia is not deployed."
    },
    {
      "action": "wait",
      "hold_ms": 5000,
      "caption": "A local prototype, with its limits shown clearly."
    }
  ],
  "preconditions": {
    "pending_transactions": 0,
    "network_chain_id": 31337,
    "initial_demo_role": "client",
    "recording_is_a_new_demo_agreement": true,
    "evidence_links_public": true,
    "note": "The recorder does not enforce this metadata. Check it before a take."
  }
}
