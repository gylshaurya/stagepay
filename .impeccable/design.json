  "narrative": {
    "northStar": "The Delivery Desk",
    "overview": "Stagepay uses the clarity of a parcel tracking desk for collaborative project work. A pale blue canvas, navy identity band and white work sheets establish a calm, practical setting. Restrained blue actions and humanist typography make decisions easy to locate.\n\nThe visual system is flat, moderately dense and explicit about state. Numbered work rows, attached evidence and expandable receipts create continuity between an agreement and its outcome. Plain language and visible local-demo context keep the interface honest.\n\nThe public workspace in `public-app` extends the same Delivery Desk identity to Ethereum Sepolia. It keeps the palette, Source Sans typography, flat sheets and numbered work rows. Connected wallet identity replaces the local Demo role selector; shared project text, confirmed receipts and an explicitly illustrative public example use the existing forms, notices and disclosure language.",
    "keyCharacteristics": [
      "Pale blue surroundings and white work sheets with quiet borders.",
      "Humanist type, compact labels and readable scope text.",
      "Numbered delivery rows with written status and a small status dot.",
      "Native disclosures keep evidence and secondary actions close to their context."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "Color accompanies readable state text; a dot alone does not explain project or milestone status.",
        "section": "colors"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Separate information with borders, whitespace and tonal fills before adding any elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use blue for primary actions and links, with navy for identity and readable text.",
      "Do pair status color with a written state and retain visible keyboard focus.",
      "Do keep long evidence URLs and hashes wrapping within their containers.",
      "Do retain the compact two-column project and role controls on mobile, with connection and create controls on a separate row.",
      "Do keep local-demo and test-token labels visible and put transaction details beside their receipts.",
      "Do distinguish the public connected wallet from local demo roles, and keep shared-text verification beside the relevant scope or delivery.",
      "Do label public examples as illustrative work and make pending-receipt recovery a clear action."
    ],
    "donts": [
      "Don't add gradients, glow, decorative metric tiles or a speculative crypto dashboard.",
      "Don't replace the humanist sans with display typography or invent an extra type family.",
      "Don't hide the route to milestones behind agreement-management disclosures on mobile.",
      "Don't label the demo role switch as authentication or local receipts as public testnet proof."
    ]
  }
