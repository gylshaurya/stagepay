      "css": ".ds-disclosure{font-family:Source Sans,'Trebuchet MS',sans-serif;color:var(--ink,#17334c);}.ds-summary{display:flex;justify-content:space-between;align-items:center;gap:14px;font-weight:600;font-size:.92rem;padding:13px 0;cursor:pointer;list-style:none;}.ds-summary::-webkit-details-marker{display:none;}.ds-summary:focus-visible{outline:3px solid #4c86ba;}.ds-chevron{width:12px;height:12px;fill:none;stroke:var(--muted,#526578);stroke-width:1.8;transition:transform .18s ease-out;}.ds-disclosure[open]>.ds-summary .ds-chevron{transform:rotate(180deg);}.ds-detail{padding:6px 0 14px;font-size:.9rem;line-height:1.5;color:var(--muted,#526578);}@media(prefers-reduced-motion:reduce){.ds-chevron{transition:none;}}"
